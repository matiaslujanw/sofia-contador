# Posible únicamente con `next dev` en localhost. Usar solo datos sintéticos.
SOFIA_DEMO_MODE=0

# URL y clave publicable del proyecto. Nunca usar service_role ni una clave secreta.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origen canónico del sitio y secreto del servidor para recuperación de contraseña.
# Ejemplo para generar un secreto: openssl rand -hex 32
SOFIA_SITE_URL=http://localhost:3000
SOFIA_AUTH_SECRET=
